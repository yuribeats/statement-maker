    function params() external pure returns (Params memory) { return _params; }
    function depositOrder() external pure returns (uint256[] memory) { return _order; }
    function burnOrder() external pure returns (uint256[] memory) { return _burnOrder; }
    function count() public pure returns (uint256) { return _order.length; }
    function proposalCount() external pure returns (uint256) { return _proposals.length; }
