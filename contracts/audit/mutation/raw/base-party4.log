    /// @param buyDelayHours for a price: the wait (0..72 hours) before buying opens once it goes live; ignored for cancels.
    function propose(PriceSpec calldata price, bool cancel, uint16 hours_, uint16 buyDelayHours) private returns (uint256 id) {
